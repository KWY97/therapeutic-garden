#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIRECTORY="$(cd "${SCRIPT_DIRECTORY}/.." && pwd)"

cd "${PROJECT_DIRECTORY}"
RUNTIME_CLASSPATH="$(./gradlew -q participantPasswordResetClasspath)"
JAVA_EXECUTABLE="$(./gradlew -q participantPasswordResetJavaExecutable)"

exec "${JAVA_EXECUTABLE}" \
  -Djdk.console=java.base \
  -Dspring.jpa.hibernate.ddl-auto=none \
  -Dspring.jpa.show-sql=false \
  -cp "${RUNTIME_CLASSPATH}" \
  com.example.manage.passwordreset.ParticipantPasswordResetCli "$@"
